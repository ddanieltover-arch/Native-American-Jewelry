# Public (required on Vercel — used at build + runtime)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (required on Vercel for login + API routes)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

SCRAPER_SERVICE_URL=https://your-scraper.onrender.com
SCRAPER_API_KEY=your_scraper_api_key
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=orders@nativeamericanjewelry.com
ADMIN_EMAIL=admin@nativeamericanjewelry.com
NODE_ENV=production
