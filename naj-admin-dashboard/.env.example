# Neon (primary Postgres)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=naj-assets
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Supabase Auth only
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

SCRAPER_SERVICE_URL=https://your-scraper.onrender.com
SCRAPER_API_KEY=your_scraper_api_key
NEXT_PUBLIC_BULL_BOARD_URL=http://localhost:3001
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=orders@nativeamericanjewelry.com
ADMIN_EMAIL=admin@nativeamericanjewelry.com
NEXT_PUBLIC_SITE_URL=https://nativeamericanjewelry.com
ADMIN_SITE_URL=https://admin.nativeamericajewelry.com
PAYMENT_CHIME_HANDLE=$YourChime
PAYMENT_CASHAPP_TAG=$YourCashApp
PAYMENT_APPLE_CASH_PHONE=+1-555-555-5555
PAYMENT_ZELLE_EMAIL=orders@nativeamericanjewelry.com
