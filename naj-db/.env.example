# Neon (pooled for apps; direct for dumps/migrations)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Source Supabase Postgres (Settings → Database → Connection string URI)
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase API (Auth + Storage migration source)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=naj-assets
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# Optional custom domain: https://cdn.nativeamericanjewelry.com
