# ─── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=product-images

# ─── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nativeamericanjewelry.com
NEXT_PUBLIC_BRAND_NAME="Native American Jewelry"

# ─── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=orders@nativeamericanjewelry.com
ADMIN_EMAIL=admin@nativeamericanjewelry.com
# Optional: link in new-order admin emails (defaults to storefront URL)
# ADMIN_SITE_URL=https://your-admin.vercel.app
# Payment details shown in order / payment emails
PAYMENT_CHIME_HANDLE=$YourChime
PAYMENT_CASHAPP_TAG=$YourCashApp
PAYMENT_APPLE_CASH_PHONE=+1-555-555-5555
PAYMENT_ZELLE_EMAIL=orders@nativeamericanjewelry.com
PAYMENT_BANK_NAME=Your Bank
PAYMENT_BANK_ROUTING=000000000
PAYMENT_BANK_ACCOUNT=0000000000

# ─── Customer auth (Supabase Auth + cookie sessions) ───────────
# In Supabase Dashboard → Authentication → URL Configuration, add:
#   Site URL: NEXT_PUBLIC_SITE_URL
#   Redirect URLs: {SITE_URL}/auth/callback, {SITE_URL}/account/reset-password

# ─── Admin Dashboard ──────────────────────────────────────────
ADMIN_JWT_SECRET=generate_separate_secret_for_admin
CSRF_SECRET=generate_another_32_char_secret

# ─── Queue (Redis / Upstash) ──────────────────────────────────
REDIS_URL=rediss://default:your_token@your-project.upstash.io:6379
REDIS_TOKEN=your_upstash_rest_token

# ─── Scraper ──────────────────────────────────────────────────
TARGET_URL=https://hippiecowgirlcouture.com
MIN_PRICE_FILTER=150
DISCOUNT_RATE=0.05
PROXY_URL=

# ─── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Monitoring (optional) ────────────────────────────────────
SENTRY_DSN=
LOGTAIL_SOURCE_TOKEN=

# ─── Node ─────────────────────────────────────────────────────
NODE_ENV=development
