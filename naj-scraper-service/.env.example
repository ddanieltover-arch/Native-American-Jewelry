# ─── Neon (primary Postgres) ───────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Cloudflare R2 ─────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=naj-assets
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# ─── Redis (Upstash or local) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Scraper targets ───────────────────────────────────────
TARGET_URL=https://hippiecowgirlcouture.com
MIN_PRICE_FILTER=150
DISCOUNT_RATE=0.05
MAX_PRODUCTS_PER_RUN=0
SCRAPE_INLINE=true
MAX_IMAGES_PER_PRODUCT=2

# ─── Proxy (optional) ──────────────────────────────────────
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@nativeamericanjewelry.com
FROM_EMAIL=scraper@nativeamericanjewelry.com

# ─── Branding ──────────────────────────────────────────────
BRAND_WATERMARK_PATH=./assets/watermark.png
BRAND_NAME=Native American Jewelry

# ─── Concurrency ───────────────────────────────────────────
SCRAPE_CONCURRENCY=2
IMAGE_CONCURRENCY=3
PAGE_TIMEOUT_MS=30000
REQUEST_DELAY_MIN_MS=1500
REQUEST_DELAY_MAX_MS=4000

# ─── Scheduler ─────────────────────────────────────────────
SCRAPE_CRON=0 3 * * *

# ─── API auth ──────────────────────────────────────────────
SCRAPER_API_KEY=generate_a_long_random_secret
PORT=4000

NODE_ENV=development
LOG_LEVEL=info
