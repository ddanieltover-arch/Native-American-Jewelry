# ─── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=product-images

# ─── Redis (Upstash or local) ──────────────────────────────
REDIS_URL=redis://localhost:6379
# For Upstash:
# REDIS_URL=rediss://default:TOKEN@your-project.upstash.io:6379

# ─── Scraper targets ───────────────────────────────────────
TARGET_URL=https://hippiecowgirlcouture.com
MIN_PRICE_FILTER=150
DISCOUNT_RATE=0.05

# ─── Proxy (optional — recommended for production) ─────────
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@nativeamericanjewelry.com
FROM_EMAIL=scraper@nativeamericanjewelry.com

# ─── Branding ──────────────────────────────────────────────
BRAND_WATERMARK_PATH=./assets/watermark.png
BRAND_NAME=Native American Jewelry

# ─── Concurrency controls ──────────────────────────────────
SCRAPE_CONCURRENCY=2
IMAGE_CONCURRENCY=3
PAGE_TIMEOUT_MS=30000
REQUEST_DELAY_MIN_MS=1500
REQUEST_DELAY_MAX_MS=4000

# ─── Scheduler ─────────────────────────────────────────────
# Cron expression for scheduled scrapes (default: 3am UTC daily)
SCRAPE_CRON=0 3 * * *

# ─── Environment ───────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
