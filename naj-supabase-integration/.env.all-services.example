# ═══════════════════════════════════════════════════════════
# Native American Jewelry — All Services Env Template
# Auth = Supabase | Data = Neon | Files = Cloudflare R2
# See also: naj-db/.env.example and naj-db/CUTOVER.md
# ═══════════════════════════════════════════════════════════

# ─── SHARED ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET=naj-assets
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Supabase Auth only
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_NEVER_EXPOSE_CLIENT_SIDE
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_safe_for_browser

# ─── STOREFRONT (naj-storefront) ──────────────────────────
NEXT_PUBLIC_SITE_URL=https://nativeamericanjewelry.com
NEXT_PUBLIC_BRAND_NAME=Native American Jewelry
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=orders@nativeamericanjewelry.com
NODE_ENV=production

# ─── ADMIN DASHBOARD (naj-admin) ──────────────────────────
ADMIN_EMAIL=admin@nativeamericanjewelry.com
SCRAPER_SERVICE_URL=https://your-scraper-service.railway.app
SCRAPER_API_KEY=generate_a_long_random_key_here

# ─── SCRAPER SERVICE (naj-scraper) ────────────────────────
REDIS_URL=rediss://default:TOKEN@your-project.upstash.io:6379
TARGET_URL=https://hippiecowgirlcouture.com
MIN_PRICE_FILTER=150
DISCOUNT_RATE=0.05
FROM_EMAIL=scraper@nativeamericanjewelry.com
BRAND_WATERMARK_PATH=./assets/watermark.png
BRAND_NAME=Native American Jewelry
SCRAPE_CONCURRENCY=2
IMAGE_CONCURRENCY=3
SCRAPE_CRON=0 3 * * *
PORT=4000
LOG_LEVEL=info
